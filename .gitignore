node_modules/**

# Build output
dist/**

# Test coverage reports
coverage/**

# Badge SVGs: generated by CI and published to the orphan "badges" branch,
# never committed to master. A bot commit on master steals the tip of the
# branch, which is how releases used to end up tagged on the wrong commit.
.github/badges/*.svg

# TypeScript incremental build state (generated by `npm run typecheck`).
# Machine-local caches: tracking them conflicted on nearly every pull request.
tsconfig.tsbuildinfo
*.tsbuildinfo

# Claude Code local state (was covered by the previous ".c**" pattern)
.claude/

tester-darwin-arm64/**
flows-tester-darwin-arm64/**
tester-win32-x64/**

.DS_Store
