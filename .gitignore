node_modules/**

# Build output
dist/**

# Test coverage reports
coverage/**

# Badge SVGs: generated by CI and published to the orphan "badges" branch,
# never committed to master. A bot commit on master steals the tip of the
# branch, which is how releases used to end up tagged on the wrong commit.
.github/badges/*.svg

# TypeScript incremental build state (generated by `npm run typecheck`).
# Machine-local caches: tracking them conflicted on nearly every pull request.
tsconfig.tsbuildinfo
*.tsbuildinfo

# Claude Code local state (was covered by the previous ".c**" pattern)
.claude/

# The context `npm run dev` works in: an empty folder the tool furnishes with
# its own examples on first start, so development never writes into the repo
.dev-context/**

tester-darwin-arm64/**
flows-tester-darwin-arm64/**
tester-win32-x64/**

.DS_Store

# What a run of ronsel's own flows (npm run e2e) writes into the e2e/
# context: the runs it records, and the tsconfig ronsel refreshes on every
# start, whose paths are absolute and machine-local
e2e/test-runs/**
e2e/tsconfig.json
e2e/.env
