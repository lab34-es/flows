---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemedShot from "../components/ThemedShot.astro";
import { withBase } from "../lib/help.js";
import flowDark from "../../../frontend/public/help-images/flow-dark.webp";
import flowLight from "../../../frontend/public/help-images/flow-light.webp";
import folderDark from "../../../frontend/public/help-images/folder-dark.webp";
import folderLight from "../../../frontend/public/help-images/folder-light.webp";
import aiCreateDark from "../../../frontend/public/help-images/ai-create-dark.webp";
import aiCreateLight from "../../../frontend/public/help-images/ai-create-light.webp";
import aiEditDark from "../../../frontend/public/help-images/ai-edit-dark.webp";
import aiEditLight from "../../../frontend/public/help-images/ai-edit-light.webp";

const repoUrl = "https://github.com/lab34-es/flows";

// Templates as they are written inside a flow — literal, never interpolated.
const tInt = "{{ randomInt0_9999 }}";
const tName = "{{ randomName }}";
const tPostal = "{{ randomPostalCode }}";
const tShip = "{{ shipmentId }}";
const tCourier = "{{ randomPostmanId }}";

// Pre-recorded evidence for the demo document. Plain text, no markup.
const out1 = `{ "shipmentId": "SHP-70491", "orderRef": "ORD-3817",
  "status": "in_transit", "trackingRef": "TRK-9C41V2" }`;
const out2 = 'rows: [ { "status": "in_transit", "attempts": 1 } ]';
const out3 = 'wms/shipments/SHP-70491 ← { "status": "reattempt_scheduled" }';
const out4 = `rows: [ { "status": "reattempt_scheduled", "attempts": 2,
          "next_attempt_at": "2026-08-19T08:00:00Z" } ]`;

const capabilities = [
    {
        title: "HTTP APIs",
        body: "Call any method of your applications. Assert on status, headers and body.",
    },
    {
        title: "PostgreSQL",
        body: "Ask the database directly when the API is not the only source of truth.",
    },
    {
        title: "MQTT",
        body: "Subscribe before the flow starts and assert on what arrives, whenever it arrives.",
    },
    {
        title: "Mimic",
        body: "Fake a dependency per step, failure scenarios included.",
    },
    {
        title: "Random data",
        body: "Fresh names, ids and dates on every attempt, from built-in replacers.",
    },
    {
        title: "Memory & $expr",
        body: "Steps share what they learn. Assertions go beyond equality.",
    },
    {
        title: "Retry & delay",
        body: "Async systems get a second look, not a flake.",
    },
    {
        title: "Environments",
        body: "Credentials live in env files per application, out of the repository.",
    },
    {
        title: "Written with AI",
        body: "Describe the scenario and get a flow built from your own applications. Local Ollama, Gemini or Claude.",
    },
];

const ownership = [
    {
        title: "MIT licensed",
        body: "Read the source, fork it, keep it forever. No vendor, no per-seat licence.",
    },
    {
        title: "Local first",
        body: "Flows are files in a folder on your machine. Version them in your own git, review them in your own PRs.",
    },
    {
        title: "Your credentials stay put",
        body: "Database passwords, Jira tokens and model keys live in your context folder. They are never sent to the browser.",
    },
    {
        title: "Works offline",
        body: "Seeded examples run with no network at all. A local model keeps even flow writing on your machine.",
    },
];

const siteUrl = new URL(withBase("/"), Astro.site).href;
const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "lab34/flows",
        url: siteUrl,
    },
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "lab34/flows",
        description:
            "End-to-end test automation where every test is a Markdown document your team reads, reviews and runs — across HTTP APIs, PostgreSQL databases and MQTT brokers.",
        url: siteUrl,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Windows, macOS, Linux",
        softwareRequirements: "Node.js",
        license: "https://opensource.org/licenses/MIT",
        offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
        downloadUrl: "https://www.npmjs.com/package/@lab34/flows",
        codeRepository: repoUrl,
        author: { "@type": "Person", name: "Jose Constela" },
    },
];
---

<BaseLayout
    title="lab34/flows — end-to-end tests your whole team can read"
    description="lab34/flows turns every end-to-end test into a Markdown document. Your team reads it, reviews it and runs it — across APIs, databases and message brokers."
    jsonLd={jsonLd}
>
    <!-- 1 · hero -->
    <section class="fl-wrap" style="padding-top:104px;padding-bottom:96px">
        <p class="fl-kicker" style="margin-bottom:28px">
            End-to-end test automation · MIT
        </p>
        <h1 class="fl-h1">
            Test knowledge shouldn't live in one engineer's code
        </h1>
        <p class="fl-lede">
            lab34/flows turns every end-to-end test into a Markdown document.
            Your team reads it, reviews it and runs it — across APIs, databases
            and message brokers.
        </p>
        <div class="fl-cta-row">
            <div class="fl-install">
                <code
                    ><span class="fl-dim">$</span> npm install -g @lab34/flows</code
                >
                <button
                    id="copy-cmd"
                    type="button"
                    class="fl-copy"
                    aria-label="Copy install command">copy</button
                >
            </div>
            <a href={withBase("/docs/")} class="fl-cta">Read the docs →</a>
        </div>
        <p class="fl-mono-note" style="margin-top:32px;max-width:70ch">
            <span class="fl-for-manager">For your manager:</span> every test case
            is a document anyone can audit, and the pipeline executes it.
        </p>
    </section>

    <!-- 2 · the problem -->
    <section class="fl-wrap">
        <div class="fl-section">
            <p class="fl-kicker">The problem</p>
            <h2 class="fl-h2" style="margin-bottom:48px;max-width:24ch">
                Where test knowledge goes to die
            </h2>
            <div class="fl-cols">
                <div class="fl-col">
                    <h3 class="fl-h3">Locked in code</h3>
                    <p class="fl-p-sm">
                        Your best engineer wrote the suite. Only they can read
                        it. When they move on, your coverage becomes a black
                        box.
                    </p>
                    <p class="fl-mono-note">
                        <span class="fl-for-manager">For your manager:</span> our
                        tests stop depending on one person.
                    </p>
                </div>
                <div class="fl-col">
                    <h3 class="fl-h3">Parked in Jira</h3>
                    <p class="fl-p-sm">
                        Your QA team wrote the test cases. They are precise,
                        reviewed and current. None of them has ever executed.
                    </p>
                    <p class="fl-mono-note">
                        <span class="fl-for-manager">For your manager:</span> the
                        cases we already wrote start running in CI.
                    </p>
                </div>
                <div class="fl-col">
                    <h3 class="fl-h3">Split across systems</h3>
                    <p class="fl-p-sm">
                        The real flow crosses an API, a database and a message
                        broker. Each tool tests one piece alone. The bug lives
                        in between.
                    </p>
                    <p class="fl-mono-note">
                        <span class="fl-for-manager">For your manager:</span> one
                        test follows the whole flow, end to end.
                    </p>
                </div>
            </div>
            <p class="fl-claim">
                One artifact does both jobs. A document people read. A test the
                pipeline runs.
            </p>
        </div>
    </section>

    <!-- 3 · the flow document -->
    <section class="fl-wrap-wide">
        <div class="fl-section">
            <p class="fl-kicker">An example flow</p>
            <h2 class="fl-h2" style="max-width:26ch">
                One document. Three systems. One answer.
            </h2>
            <p class="fl-p" style="margin-bottom:12px">
                This is how a flow looks inside the tool. The example tests a
                logistics scenario — a delivery fails and the parcel is
                rescheduled — and checks that the tracking API, the warehouse
                database and the picking screens still agree. Press Run on any
                step: the executions are pre-recorded, nothing leaves this page.
            </p>
            <p class="fl-mono-note" style="margin:0 0 40px">
                Notes in the margin name the capability each part demonstrates.
            </p>

            <!-- document chrome -->
            <div class="fl-doc" id="flow">
                <div class="fl-doc-head">
                    <span class="fl-doc-path"
                        >flows/logistics/failed-delivery-retry.md</span
                    >
                    <span class="fl-badge">MARKDOWN</span>
                    <span class="fl-badge" data-flow="standby">STANDBY</span>
                    <span
                        class="fl-badge fl-badge-running"
                        data-flow="running"
                        hidden>RUNNING</span
                    >
                    <span
                        class="fl-badge fl-badge-passed"
                        data-flow="passed"
                        hidden>PASSED</span
                    >
                    <span class="fl-spacer"></span>
                    <button
                        type="button"
                        class="fl-btn-reset"
                        data-flow="touched"
                        hidden>reset</button
                    >
                    <button type="button" class="fl-btn-run" data-run="all"
                        >▷ Run flow</button
                    >
                </div>

                <div class="fl-doc-body">
                    <!-- segment: title + frontmatter -->
                    <div class="fl-seg">
                        <div class="fl-seg-main">
                            <h3 class="fl-doc-title">
                                A failed delivery is rescheduled
                            </h3>
                            <p
                                class="fl-p-sm fl-quiet"
                                style="margin-bottom:28px;max-width:66ch"
                            >
                                When the courier reports the recipient absent,
                                the parcel is queued for a second attempt and
                                the warehouse is told.
                            </p>
                            <div class="fl-beacon-slot">
                                <button
                                    type="button"
                                    class="fl-beacon"
                                    data-beacon="1"
                                    aria-expanded="false"
                                    aria-label="What is this part? The frontmatter"
                                    >i</button
                                >
                                <div
                                    class="fl-pop"
                                    role="note"
                                    data-pop="1"
                                    hidden
                                >
                                    <p class="fl-pop-label">the frontmatter</p>
                                    <p class="fl-pop-text">
                                        YAML at the top of the file, rendered as
                                        editable properties. Anything you write
                                        here — owner, priority, due — becomes a
                                        column in folder views.
                                    </p>
                                </div>
                            </div>
                            <div class="fl-props">
                                <div class="fl-prop">
                                    <span class="fl-prop-key">owner</span><span
                                        >ana</span>
                                </div>
                                <div class="fl-prop">
                                    <span class="fl-prop-key">priority</span
                                    ><span>8</span>
                                </div>
                                <div class="fl-prop">
                                    <span class="fl-prop-key">tags</span>
                                    <span class="fl-tags">
                                        <span class="fl-tag">logistics</span>
                                        <span class="fl-tag">last-mile</span>
                                        <span class="fl-tag">smoke</span>
                                    </span>
                                </div>
                                <div class="fl-prop">
                                    <span class="fl-prop-key">reviewed</span
                                    ><span class="fl-pass">✓ true</span>
                                </div>
                                <div class="fl-prop">
                                    <span class="fl-prop-key">due</span><span
                                        >2026-09-30</span
                                    >
                                </div>
                                <div class="fl-prop">
                                    <span class="fl-prop-key">xray.testKey</span
                                    ><span class="fl-brass-text">WMS-482</span>
                                </div>
                                <div class="fl-prop">
                                    <span class="fl-prop-key">latent apps</span
                                    ><span
                                        >mqtt · client warehouse ·
                                        wms/shipments/+</span
                                    >
                                </div>
                            </div>
                        </div>
                        <aside
                            class="fl-seg-aside"
                            aria-label="Capability notes"
                        >
                            <div class="fl-ann">
                                <p class="fl-ann-label">Shows: properties</p>
                                <p class="fl-ann-text">
                                    Any property you invent becomes a column
                                </p>
                                <a href={withBase("/docs/flows/")}
                                    >/docs/flows/</a
                                >
                            </div>
                            <div class="fl-ann">
                                <p class="fl-ann-label">Shows: Xray link</p>
                                <p class="fl-ann-text">
                                    Linked to the Test issue in Jira
                                </p>
                                <a href={withBase("/docs/xray/")}>/docs/xray/</a
                                >
                            </div>
                            <div class="fl-ann">
                                <p class="fl-ann-label">
                                    Shows: latent applications
                                </p>
                                <p class="fl-ann-text">
                                    Subscribed before the flow starts
                                </p>
                                <a href={withBase("/docs/latent-applications/")}
                                    >/docs/latent-applications/</a
                                >
                            </div>
                        </aside>
                    </div>

                    <!-- segment: intro prose -->
                    <div class="fl-seg fl-seg-prose">
                        <div class="fl-seg-main" style="max-width:70ch">
                            <div class="fl-beacon-slot">
                                <button
                                    type="button"
                                    class="fl-beacon fl-beacon-2"
                                    data-beacon="2"
                                    aria-expanded="false"
                                    aria-label="What is this part? The prose"
                                    >i</button
                                >
                                <div
                                    class="fl-pop"
                                    role="note"
                                    data-pop="2"
                                    hidden
                                >
                                    <p class="fl-pop-label">the prose</p>
                                    <p class="fl-pop-text">
                                        Plain Markdown between the steps. This
                                        is the documentation half of the
                                        document — the part your whole team
                                        reads.
                                    </p>
                                </div>
                            </div>
                            <p class="fl-p-doc">
                                A parcel leaves the warehouse and the courier
                                cannot hand it over: nobody is home. Three
                                systems have to agree on what happens next. The
                                tracking API must accept the failed attempt, the
                                warehouse database must schedule a second one,
                                and the pickers must hear about it over MQTT —
                                because the parcel is going back on a van
                                tomorrow morning and somebody has to pull it off
                                the returns lane before then.
                            </p>
                            <p class="fl-p-doc" style="margin-bottom:0">
                                This is the flow that proves all three still
                                agree. It runs against the real warehouse, with
                                the courier faked: no carrier will fail a
                                delivery on request, and waiting for a real one
                                to go wrong is not a test strategy.
                            </p>
                        </div>
                        <aside class="fl-seg-aside">
                            <div class="fl-ann">
                                <p class="fl-ann-label">Shows: flow anatomy</p>
                                <p class="fl-ann-text">
                                    This is documentation. It is also the test
                                </p>
                                <a href={withBase("/docs/concepts/")}
                                    >/docs/concepts/</a
                                >
                            </div>
                        </aside>
                    </div>

                    <!-- segment: step 1 -->
                    <div class="fl-seg">
                        <div
                            class="fl-seg-main"
                            data-step="1"
                            data-state="standby"
                        >
                            <h4 class="fl-h4">The parcel ships</h4>
                            <p
                                class="fl-p-sm"
                                style="margin-bottom:18px;max-width:66ch"
                            >
                                A new shipment for a random order. The courier's
                                label service is mimicked, so this step is the
                                same in a laptop with no VPN as it is in
                                staging.
                            </p>
                            <div class="fl-beacon-slot">
                                <button
                                    type="button"
                                    class="fl-beacon fl-beacon-3"
                                    data-beacon="3"
                                    aria-expanded="false"
                                    aria-label="What is this part? A step block"
                                    >i</button
                                >
                                <div
                                    class="fl-pop"
                                    role="note"
                                    data-pop="3"
                                    hidden
                                >
                                    <p class="fl-pop-label">a step block</p>
                                    <p class="fl-pop-text">
                                        A fenced ```step code block — the
                                        executable half. Press Run and the
                                        evidence appears right below it.
                                    </p>
                                </div>
                            </div>
                            <div class="fl-step">
                                <div class="fl-step-head">
                                    <span class="fl-step-n">step 1</span>
                                    <span class="fl-step-call"
                                        >wms · createShipment</span
                                    >
                                    <span class="fl-spacer"></span>
                                    <span
                                        class="fl-step-state"
                                        data-when="standby">standby</span
                                    >
                                    <span
                                        class="fl-step-state fl-step-state-running"
                                        data-when="running"
                                        hidden>running</span
                                    >
                                    <span
                                        class="fl-step-state fl-step-state-passed"
                                        data-when="passed"
                                        hidden>passed</span
                                    >
                                    <button
                                        type="button"
                                        class="fl-btn-run-sm"
                                        data-run="1">▷ Run</button
                                    >
                                </div>
                                <pre
                                    class="fl-code"><span class="fl-k">application:</span> wms
<span class="fl-k">method:</span> createShipment
<span class="fl-k">parameters:</span>
  <span class="fl-k">body:</span>
    <span class="fl-k">orderRef:</span> "ORD-<span class="fl-dim">{tInt}</span>"
    <span class="fl-k">recipient:</span> "<span class="fl-dim">{tName}</span>"
    <span class="fl-k">postalCode:</span> "<span class="fl-dim">{tPostal}</span>"
    <span class="fl-k">service:</span> next-day
<span class="fl-k">mimic:</span>
  - <span class="fl-k">application:</span> carrier
    <span class="fl-k">url:</span> "/labels"
<span class="fl-k">test:</span>
  <span class="fl-k">status:</span> 201
  <span class="fl-k">body:</span>
    <span class="fl-k">status:</span> "in_transit"
    <span class="fl-k">trackingRef:</span> "$expr: typeof value === 'string' &amp;&amp; value.length &gt; 0"</pre>
                            </div>
                            <div aria-live="polite">
                                <div
                                    class="fl-result"
                                    data-when="passed"
                                    hidden
                                >
                                    <div class="fl-beacon-slot">
                                        <button
                                            type="button"
                                            class="fl-beacon"
                                            data-beacon="4"
                                            aria-expanded="false"
                                            aria-label="What is this part? The execution"
                                            >i</button
                                        >
                                        <div
                                            class="fl-pop"
                                            role="note"
                                            data-pop="4"
                                            hidden
                                        >
                                            <p class="fl-pop-label">
                                                the execution
                                            </p>
                                            <p class="fl-pop-text">
                                                Status, timing, response and
                                                every assertion — streamed in
                                                right below the block, like a
                                                notebook cell.
                                            </p>
                                        </div>
                                    </div>
                                    <p class="fl-result-head">
                                        ● Passed · 212 ms · HTTP 201
                                    </p>
                                    <pre class="fl-result-body">{out1}</pre>
                                    <p class="fl-result-assert">
                                        ✓ status 201 &nbsp;✓ body.status &nbsp;✓
                                        body.trackingRef ($expr) — all
                                        assertions passed
                                    </p>
                                    <p class="fl-result-memory">
                                        memory.shipmentId ← "SHP-70491"
                                    </p>
                                </div>
                            </div>
                        </div>
                        <aside class="fl-seg-aside fl-seg-aside-step">
                            <div class="fl-ann">
                                <p class="fl-ann-label">Shows: replacers</p>
                                <p class="fl-ann-text">
                                    Fresh data on every run
                                </p>
                                <a href={withBase("/docs/replacers/")}
                                    >/docs/replacers/</a
                                >
                            </div>
                            <div class="fl-ann">
                                <p class="fl-ann-label">Shows: mimic</p>
                                <p class="fl-ann-text">
                                    The courier, faked — including the failure
                                </p>
                                <a href={withBase("/docs/step-blocks/")}
                                    >/docs/step-blocks/</a
                                >
                            </div>
                        </aside>
                    </div>

                    <!-- segment: step 2 -->
                    <div class="fl-seg">
                        <div
                            class="fl-seg-main"
                            data-step="2"
                            data-state="standby"
                        >
                            <h4 class="fl-h4">The warehouse agrees</h4>
                            <p
                                class="fl-p-sm"
                                style="margin-bottom:18px;max-width:66ch"
                            >
                                The API said <code class="fl-inline-code"
                                    >in_transit</code
                                >. The database is where the pickers actually
                                look, so ask it directly.
                                <code class="fl-inline-code">{tShip}</code> is what
                                the previous step wrote to flow memory.
                            </p>
                            <div class="fl-step">
                                <div class="fl-step-head">
                                    <span class="fl-step-n">step 2</span>
                                    <span class="fl-step-call"
                                        >warehouse-db · query</span
                                    >
                                    <span class="fl-spacer"></span>
                                    <span
                                        class="fl-step-state"
                                        data-when="standby">standby</span
                                    >
                                    <span
                                        class="fl-step-state fl-step-state-running"
                                        data-when="running"
                                        hidden>running</span
                                    >
                                    <span
                                        class="fl-step-state fl-step-state-passed"
                                        data-when="passed"
                                        hidden>passed</span
                                    >
                                    <button
                                        type="button"
                                        class="fl-btn-run-sm"
                                        data-run="2">▷ Run</button
                                    >
                                </div>
                                <pre
                                    class="fl-code"><span class="fl-k">application:</span> warehouse-db
<span class="fl-k">method:</span> query
<span class="fl-k">parameters:</span>
  <span class="fl-k">body:</span>
    <span class="fl-k">sql:</span> "select status, attempts from shipments where id = $1"
    <span class="fl-k">values:</span>
      - "<span class="fl-dim">{tShip}</span>"
<span class="fl-k">test:</span>
  <span class="fl-k">status:</span> 200
  <span class="fl-k">body:</span>
    <span class="fl-k">rows:</span>
      <span class="fl-k">0:</span>
        <span class="fl-k">status:</span> "in_transit"
        <span class="fl-k">attempts:</span> 1</pre>
                            </div>
                            <div aria-live="polite">
                                <div
                                    class="fl-result"
                                    data-when="passed"
                                    hidden
                                >
                                    <p class="fl-result-head">
                                        ● Passed · 8 ms · 1 row
                                    </p>
                                    <pre class="fl-result-body">{out2}</pre>
                                    <p class="fl-result-assert">
                                        ✓ rows.0.status &nbsp;✓ rows.0.attempts
                                        — all assertions passed
                                    </p>
                                </div>
                            </div>
                        </div>
                        <aside class="fl-seg-aside fl-seg-aside-step">
                            <div class="fl-ann">
                                <p class="fl-ann-label">Shows: flow memory</p>
                                <p class="fl-ann-text">
                                    What step one wrote, step two reads
                                </p>
                                <a href={withBase("/docs/memory/")}
                                    >/docs/memory/</a
                                >
                            </div>
                            <div class="fl-ann">
                                <p class="fl-ann-label">
                                    Shows: PostgreSQL steps
                                </p>
                                <p class="fl-ann-text">
                                    The API is not the only source of truth
                                </p>
                                <a href={withBase("/docs/applications/")}
                                    >/docs/applications/</a
                                >
                            </div>
                        </aside>
                    </div>

                    <!-- segment: step 3 -->
                    <div class="fl-seg">
                        <div
                            class="fl-seg-main"
                            data-step="3"
                            data-state="standby"
                        >
                            <h4 class="fl-h4">The courier finds nobody home</h4>
                            <p
                                class="fl-p-sm"
                                style="margin-bottom:18px;max-width:66ch"
                            >
                                The failure we came for. The response is
                                immediate, but the interesting part is
                                asynchronous: an event on
                                <code class="fl-inline-code"
                                    >wms/shipments/{tShip}</code
                                > that the picking screens subscribe to. The MQTT
                                client has been connected and subscribed since before
