     * evidence panels are revealed in the same order the real tool streams them.
     */
    const flow = document.getElementById("flow");

    if (flow) {
        const STEPS = [1, 2, 3, 4];
        const state = {
            1: "standby",
            2: "standby",
            3: "standby",
            4: "standby",
        };
        let latent = 0; // step 3's MQTT retry substate: 0, 1 or 2
        let timers = [];
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

        const later = (fn, ms) => timers.push(setTimeout(fn, ms));
        const stopTimers = () => {
            timers.forEach(clearTimeout);
            timers = [];
        };

        function render() {
            STEPS.forEach((n) => {
                const step = flow.querySelector(`[data-step="${n}"]`);
                if (!step) return;
                step.dataset.state = state[n];
                step.querySelectorAll("[data-when]").forEach((node) => {
                    const when = node.dataset.when;
                    let show;
                    if (when === "a1")
                        show = state[3] === "running" && latent === 1;
                    else if (when === "a2")
                        show = state[3] === "running" && latent >= 2;
                    else show = when === state[n];
                    node.hidden = !show;
                });
            });

            const running = STEPS.some((n) => state[n] === "running");
            const passed = STEPS.every((n) => state[n] === "passed");
            const touched = STEPS.some((n) => state[n] !== "standby");
            flow.querySelectorAll("[data-flow]").forEach((node) => {
                const key = node.dataset.flow;
                const show =
                    key === "running"
                        ? running
                        : key === "passed"
                          ? passed
                          : key === "touched"
                            ? touched
                            : !running && !passed;
                node.hidden = !show;
            });
        }

        function runStep(n, done) {
            if (state[n] === "running") return;
            if (reduced) {
                state[n] = "passed";
                if (n === 3) latent = 2;
                render();
                done && done();
                return;
            }
            state[n] = "running";
            if (n === 3) {
                latent = 0;
                render();
                later(() => {
                    latent = 1;
                    render();
                }, 350);
                later(() => {
                    latent = 2;
                    render();
                }, 1800);
                later(() => {
                    state[3] = "passed";
                    render();
                    done && done();
                }, 2400);
            } else {
                render();
                later(
                    () => {
                        state[n] = "passed";
                        render();
                        done && done();
                    },
                    n === 1 ? 320 : 220,
                );
            }
        }

        function reset() {
            stopTimers();
            STEPS.forEach((n) => (state[n] = "standby"));
            latent = 0;
            render();
        }

        function runAll() {
            if (STEPS.some((n) => state[n] === "running")) return;
            reset();
            later(
                () =>
                    runStep(1, () =>
                        runStep(2, () => runStep(3, () => runStep(4))),
                    ),
                60,
            );
        }

        flow.querySelectorAll("[data-run]").forEach((button) => {
            button.addEventListener("click", () => {
                const target = button.dataset.run;
                if (target === "all") runAll();
                else runStep(Number(target));
            });
        });
        flow.querySelector('[data-flow="touched"]')?.addEventListener(
            "click",
            reset,
        );

        // "What is this part?" beacons — one note open at a time.
        const beacons = Array.from(flow.querySelectorAll("[data-beacon]"));
        function openBeacon(id) {
            beacons.forEach((button) => {
                const open = button.dataset.beacon === id;
                button.setAttribute("aria-expanded", String(open));
                const note = flow.querySelector(
                    `[data-pop="${button.dataset.beacon}"]`,
                );
                if (note) note.hidden = !open;
            });
        }
        beacons.forEach((button) => {
            button.addEventListener("click", () => {
                const open = button.getAttribute("aria-expanded") === "true";
                openBeacon(open ? null : button.dataset.beacon);
            });
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") openBeacon(null);
        });

        render();
    }

    /* Screenshots open full size in a modal dialog, in the capture that matches
     * the theme currently on screen. */
    const lightbox = document.getElementById("shot-lightbox");

    if (lightbox) {
        const full = lightbox.querySelector("[data-lightbox-img]");
        const caption = lightbox.querySelector("[data-lightbox-cap]");

        document.querySelectorAll(".fl-shot-open").forEach((shot) => {
            shot.addEventListener("click", () => {
                const dark =
                    document.documentElement.classList.contains("dark");
                full.src = dark
                    ? shot.dataset.fullDark
                    : shot.dataset.fullLight;
                full.alt = shot.dataset.alt ?? "";
                const figcaption = shot
                    .closest("figure")
                    ?.querySelector("figcaption");
                caption.innerHTML = figcaption ? figcaption.innerHTML : "";
                lightbox.showModal();
            });
        });

        // A click on the backdrop lands on the dialog itself.
        lightbox.addEventListener("click", (event) => {
            if (event.target === lightbox) lightbox.close();
        });
        lightbox
            .querySelector("[data-lightbox-close]")
            ?.addEventListener("click", () => lightbox.close());
        lightbox.addEventListener("close", () => full.removeAttribute("src"));
    }

    // The hero's install command.
    const copy = document.getElementById("copy-cmd");
    copy?.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText("npm install -g @lab34/flows");
        } catch {
            /* clipboard unavailable — the command is selectable anyway */
        }
        copy.textContent = "copied";
        setTimeout(() => (copy.textContent = "copy"), 1600);
    });
</script>
