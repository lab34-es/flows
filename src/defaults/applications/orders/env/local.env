# A Kafka broker on this machine. The quickest way to have one:
#
#   docker run -d --name kafka -p 9092:9092 apache/kafka:4.2.2
#
# The flow that uses this application listens on the same cluster: change the
# brokers here and in the frontmatter of flows/examples/06-kafka-orders.md.
KAFKA_BROKERS=localhost:9092
