# An MQTT broker on this machine. The quickest way to have one:
#
#   docker run -d --name mosquitto -p 1883:1883 eclipse-mosquitto:2 mosquitto -c /mosquitto-no-auth.conf
#
# The flow that uses this application listens on the same broker: change the
# host here and in the frontmatter of flows/examples/05-mqtt-thermostat.md.
MQTT_HOST=localhost
MQTT_PORT=1883
