# An MQTT broker on this machine. The quickest way to have one:
#
#   docker run -d --name mosquitto -p 1883:1883 eclipse-mosquitto:2 mosquitto -c /mosquitto-no-auth.conf
#
# The flow that uses this application listens with these same settings
# (`connection: thermostat` in its frontmatter), so this file is the only place
# the broker is written. Add a staging.env, with MQTT_USERNAME and
# MQTT_PASSWORD if the broker asks, to run the same flow against staging.
MQTT_HOST=localhost
MQTT_PORT=1883
