{
  "name": "@lab34/flows",
  "version": "1.0.1",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/lab34-es/flows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lab34-es/flows.git"
  },
  "bugs": {
    "url": "https://github.com/lab34-es/flows/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nodemon --",
    "frontend": "npm --prefix frontend run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run frontend\"",
    "dev:prod": "npm run build:frontend && npm run build && node dist/api.js",
    "build:frontend": "npm --prefix frontend run build",
    "install:frontend": "npm --prefix frontend install",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "coverage:badge": "npm run test:coverage && node scripts/coverage-badge.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:ci": "npm audit --audit-level=critical",
    "prepublishOnly": "npm run clean && npm run build:frontend && npm run build"
  },
  "bin": {
    "lab34-flows": "./dist/cli.js"
  },
  "author": "Jose Constela <jose@lab34.es>",
  "license": "MIT",
  "description": "UI/Cli tool for testing E2E flows",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@faker-js/faker": "10.6.0",
    "@google/generative-ai": "0.24.1",
    "@types/node": "26.3.0",
    "ajv": "8.20.0",
    "axios": "1.20.0",
    "cli-highlight": "2.1.11",
    "colors": "1.4.0",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "handlebars": "4.7.9",
    "mqtt": "5.15.2",
    "ollama": "0.6.3",
    "pg": "8.23.0",
    "playwright": "1.62.1",
    "socket.io": "4.8.3",
    "temp": "0.9.4",
    "typescript": "5.9.3",
    "uuid": "14.0.2",
    "yaml": "2.9.0",
    "yargs-parser": "22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/temp": "0.9.4",
    "@types/yargs-parser": "21.0.3",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript-eslint": "8.68.0"
  }
}
