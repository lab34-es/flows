# Dependency version pinning.
#
# Every dependency in this repo is recorded as an exact version (no ^ or ~ range),
# so an `npm install` today resolves to exactly the tree CI tested. Upgrades are
# deliberate, reviewable commits rather than something that drifts in silently.
#
# save-exact makes `npm install <pkg>` write "1.2.3" instead of "^1.2.3".
save-exact=true

# Refuse to silently install a package whose "engines" field excludes our Node.
engine-strict=true
